{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-work-orchestrator/contracts/task.schema.json",
  "title": "Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "task_type",
    "objective",
    "acceptance_criteria",
    "permissions",
    "expected_outputs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "enum": [
        "analysis",
        "planning",
        "research",
        "implementation",
        "verification",
        "review",
        "synthesis",
        "general"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "prohibited_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "network",
        "git_push",
        "secrets"
      ],
      "properties": {
        "filesystem": {
          "type": "string",
          "enum": [
            "read_only",
            "scoped_write"
          ]
        },
        "network": {
          "type": "boolean"
        },
        "git_push": {
          "const": false
        },
        "secrets": {
          "type": "boolean"
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
