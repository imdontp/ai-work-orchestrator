{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-work-orchestrator/contracts/analysis-result.schema.json",
  "title": "Analysis Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "observed_facts",
    "assumptions",
    "open_questions",
    "plan",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "observed_facts": {
      "description": "What the analyst read in the repository. Separated from inference on purpose: a plan built on an assumption stated as a fact cannot be reviewed.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inferences": {
      "description": "Conclusions drawn from the facts above.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "assumptions": {
      "description": "What was taken as true without checking. A reviewer needs these to judge the plan.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "description": "What the analyst could not resolve. Empty is a claim, not a default.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "description": "The bounded steps proposed. This is what the human approves at the plan gate.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "rationale"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
