APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5432/orchestrator
# "filesystem" (default, needs nothing running) or "postgres" (`make postgres-up`).
# Artifact payloads and worker logs stay on disk either way - only the run records,
# the audit trail and artifact metadata move. An unreachable database is an error,
# never a silent fall back to the filesystem.
RUN_STORE_BACKEND=filesystem

# The repository workers operate on. Required to start a run, and it must not be this
# repository - see ADR-010.
# PROJECT_ROOT=
# Commands re-run mechanically after a write node, as argv lists. Empty proves nothing.
# VERIFICATION_COMMANDS=[["python","-m","pytest","-q"]]
# Model per worker; a model name means something to exactly one provider.
# WORKER_MODELS={"claude_code":"sonnet"}
ARTIFACT_ROOT=./artifacts
RUN_ROOT=./runs
# Workers write here. It MUST be outside this repository - see ADR-010. The app
# refuses to start if it points inside the checkout. Leave unset to use
# ~/.ai-work-orchestrator/workspaces.
# WORKTREE_ROOT=
DEFAULT_TASK_TIMEOUT_SECONDS=1800
MAX_REPAIR_ROUNDS=2
ALLOW_NETWORK_ACCESS=false
ALLOW_GIT_PUSH=false
